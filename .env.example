# Copy to .env.local and fill in.

# Supabase project URL, e.g. https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable / anon key (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Storage bucket holding the photos. Already exists; do not recreate.
NEXT_PUBLIC_SUPABASE_BUCKET=Photos
